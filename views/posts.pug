extends layout

block content
  h1 Publicaciones

  form(method='GET' action='/posts')
    input(
      type='text'
      name='search'
      placeholder='Buscar publicación'
      value=search
    )
    button(type='submit') Buscar
  br
  if posts.length === 0
    p No hay publicaciones cargadas.
  else
    each post in posts
      div
        h3= post.title
        p= post.description
        if post.Images && post.Images.length > 0
          each image in post.Images
            img(src=image.path, alt=post.title, width='300')
        br
        small Publicado el #{post.createdAt.toLocaleDateString()}
        form(method='POST' action='/posts/comment')
          input(
            type='hidden'
            name='postId'
            value=post.id
          )
          input(
            type='text'
            name='content'
            placeholder='Escribe un comentario'
            required
          )
          button(type='submit') Comentar
        if post.Comments && post.Comments.length > 0
          each comment in post.Comments
            p
              strong= comment.User.firstName + ': '
              | #{comment.content}
        hr