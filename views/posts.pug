extends layout

block content

  h1 Publicaciones

  form(method='GET' action='/posts')
    input(
      type='text'
      name='search'
      placeholder='Buscar publicación'
      value=search
    )
    button(type='submit') Buscar
  br
  if posts.length === 0
    p No hay publicaciones cargadas.
  else
    each post in posts
      div
        h3= post.title
        p= post.description
        if post.Images && post.Images.length > 0
          each image in post.Images
            img(src=image.path, alt=post.title, width='300')
            form(method='POST' action='/posts/rating')
              input(
                type='hidden'
                name='imageId'
                value=image.id
              )
              select(name='value')
                option(value='1') 1
                option(value='2') 2
                option(value='3') 3
                option(value='4') 4
                option(value='5') 5

              button(type='submit') Valorar

            if image.Ratings && image.Ratings.length > 0
              - const total = image.Ratings.reduce((sum, rating) => sum + rating.value, 0)
              - const Calificacion = total / image.Ratings.length
              p Calificación: #{Calificacion.toFixed(1)}
              p Votos: #{image.Ratings.length}

            else
              p Sin valoraciones

        br

        small Publicado el #{post.createdAt.toLocaleDateString()}

        form(method='POST' action='/posts/comment')
          input(
            type='hidden'
            name='postId'
            value=post.id
          )

          input(
            type='text'
            name='content'
            placeholder='Escribe un comentario'
            required
          )

          button(type='submit') Comentar

        if post.Comments && post.Comments.length > 0
          each comment in post.Comments
            p
              strong= comment.User.firstName + ': '
              | #{comment.content}

        hr