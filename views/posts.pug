extends layout

block content

  section.page-header
    h1 Explorar publicaciones
    p.auth-subtitle Descubrí imágenes compartidas por la comunidad.

    form.search-bar(method='GET' action='/posts')
      input(
        type='text'
        name='search'
        placeholder='Buscar publicaciones'
        value=search
      )

      button(type='submit') Buscar

  if posts.length === 0

    p.empty-message No hay publicaciones cargadas.

  else

    section.feed-grid

      each post in posts

        article.post-card

          h3= post.title

          if post.User
            p.post-author 👤 #{post.User.firstName} #{post.User.lastName}

          p.post-description= post.description

          if post.Images && post.Images.length > 0

            div.images-grid

              each image in post.Images

                div.image-box

                  img.post-image(src=image.path, alt=post.title)

                  if currentUser && post.userId != currentUser.id

                    form.rating-form(method='POST' action='/posts/rating')

                      input(
                        type='hidden'
                        name='imageId'
                        value=image.id
                      )

                      select(name='value')
                        option(value='1') 1
                        option(value='2') 2
                        option(value='3') 3
                        option(value='4') 4
                        option(value='5') 5

                      button(type='submit') Valorar

                  if image.Ratings && image.Ratings.length > 0

                    - const total = image.Ratings.reduce((sum, rating) => sum + rating.value, 0)
                    - const promedio = total / image.Ratings.length

                    div.rating-box
                      p ⭐ Calificación: #{promedio.toFixed(1)}
                      span Validaciones: #{image.Ratings.length}

                  else

                    div.rating-box
                      p Sin valoraciones
                      span Sé el primero en valorar

          small.post-date Publicado: #{post.createdAt.toLocaleDateString()}

          if currentUser

            form.comment-form(method='POST' action='/posts/comment')

              input(
                type='hidden'
                name='postId'
                value=post.id
              )

              input(
                type='text'
                name='content'
                placeholder='Escribe un comentario'
                required
              )

              button(type='submit') Comentar

          else

            p.empty-message
              a(href='/auth/login') Iniciá sesión
              |  para comentar y valorar imágenes.

          if post.Comments && post.Comments.length > 0

            div.comments

              each comment in post.Comments

                p
                  strong= comment.User.firstName + ': '
                  | #{comment.content}