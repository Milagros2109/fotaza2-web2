extends layout

block content

  section.page-header
    h1 Publicaciones de usuarios seguidos
    p.auth-subtitle Mirá las publicaciones de los usuarios que seguís.

  if posts.length === 0

    p.empty-message No hay publicaciones para mostrar.

  else

    each post in posts

      article.post-card

        h3= post.title

        p.post-description= post.description

        if post.Images && post.Images.length > 0
          each image in post.Images
            img.post-image(src=image.path, alt=post.title)

        small.post-date Publicado el #{post.createdAt.toLocaleDateString()}