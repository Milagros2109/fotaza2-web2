extends ../layout

block content

  div.form-card

    h1 Crear publicación

    p.auth-subtitle
      | Compartí una o más imágenes con la comunidad.

    form(
      method='POST'
      action='/posts/crear'
      enctype='multipart/form-data'
    )

      div.form-group
        label(for='title') Título
        input(
          type='text'
          id='title'
          name='title'
          placeholder='Ej: Atardecer en la montaña'
          value=(formValues && formValues.title) ? formValues.title : ''
          required
        )

        if errors && errors.title
          p.error= errors.title[0]

      div.form-group
        label(for='description') Descripción
        textarea(
          id='description'
          name='description'
          placeholder='Escribí una breve descripción'
        ) #{(formValues && formValues.description) ? formValues.description : ''}

        if errors && errors.description
          p.error= errors.description[0]

      div.form-group
        label(for='images') Imágenes
        input(
          type='file'
          id='images'
          name='images'
          multiple
          required
        )

      button.full-button(type='submit') Crear publicación