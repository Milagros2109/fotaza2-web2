extends ../layout

block content

  div.auth-card

    h1 Iniciar sesión

    p.auth-subtitle
      | Ingresá a tu cuenta para publicar, comentar y valorar imágenes.

    form(method='POST' action='/auth/login')

      div.form-group
        label(for='email') Email
        input(
          type='email'
          id='email'
          name='email'
          placeholder='ejemplo@gmail.com'
          value=(formValues && formValues.email) ? formValues.email : ''
          required
        )

        if errors && errors.email
          p.error= errors.email[0]

      div.form-group
        label(for='password') Contraseña
        input(
          type='password'
          id='password'
          name='password'
          placeholder='Tu contraseña'
          required
        )

        if errors && errors.password
          p.error= errors.password[0]

      button.full-button(type='submit') Iniciar sesión

    p.auth-link
      | ¿No tenés cuenta?
      a(href='/auth/registro')  Registrate acá