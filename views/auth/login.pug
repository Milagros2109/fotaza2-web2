extends ../layout

block content

  div.auth-card

    h1 Iniciar sesión

    p.auth-subtitle
      | Ingresá a tu cuenta para publicar, comentar y valorar imágenes.

    form(method='POST' action='/auth/login')

      div.form-group
        label(for='email') Email
        input(
          type='email'
          id='email'
          name='email'
          placeholder='ejemplo@gmail.com'
          required
        )

      div.form-group
        label(for='password') Contraseña
        input(
          type='password'
          id='password'
          name='password'
          placeholder='Tu contraseña'
          required
        )

      button.full-button(type='submit') iniciar sesión

    p.auth-link
      | ¿No tenés cuenta?
      a(href='/auth/registro')  Registrate acá