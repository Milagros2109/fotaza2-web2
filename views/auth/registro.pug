extends ../layout

block content

  div.auth-card

    h1 Crear cuenta

    p.auth-subtitle
      | Registrate para empezar a compartir tus fotografías.

    form(method='POST' action='/auth/registro')

      div.form-group
        label(for='firstName') Nombre
        input(
          type='text'
          id='firstName'
          name='firstName'
          placeholder='Tu nombre'
          value=(formValues && formValues.firstName) ? formValues.firstName : ''
          required
        )

        if errors && errors.firstName
          p.error= errors.firstName[0]

      div.form-group
        label(for='lastName') Apellido
        input(
          type='text'
          id='lastName'
          name='lastName'
          placeholder='Tu apellido'
          value=(formValues && formValues.lastName) ? formValues.lastName : ''
          required
        )

        if errors && errors.lastName
          p.error= errors.lastName[0]

      div.form-group
        label(for='email') Email
        input(
          type='email'
          id='email'
          name='email'
          placeholder='ejemplo@gmail.com'
          value=(formValues && formValues.email) ? formValues.email : ''
          required
        )

        if errors && errors.email
          p.error= errors.email[0]

      div.form-group
        label(for='password') Contraseña
        input(
          type='password'
          id='password'
          name='password'
          placeholder='Crear contraseña'
          required
        )

        if errors && errors.password
          p.error= errors.password[0]

      button.full-button(type='submit') Registrarse

    p.auth-link
      | ¿Ya tenés cuenta?
      a(href='/auth/login')  Iniciá sesión