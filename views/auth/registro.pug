extends ../layout

block content

  div.auth-card

    h1 Crear cuenta

    p.auth-subtitle
      | Registrate para empezar a compartir tus fotografías.

    form(method='POST' action='/auth/registro')

      div.form-group
        label(for='firstName') Nombre
        input(
          type='text'
          id='firstName'
          name='firstName'
          placeholder='Tu nombre'
          required
        )

      div.form-group
        label(for='lastName') Apellido
        input(
          type='text'
          id='lastName'
          name='lastName'
          placeholder='Tu apellido'
          required
        )

      div.form-group
        label(for='email') Email
        input(
          type='email'
          id='email'
          name='email'
          placeholder='ejemplo@gmail.com'
          required
        )

      div.form-group
        label(for='password') Contraseña
        input(
          type='password'
          id='password'
          name='password'
          placeholder='Crear contraseña'
          required
        )

      button.full-button(type='submit')
        Registrarse

    p.auth-link
      | ¿Ya tenés cuenta?
      a(href='/auth/login')  Iniciá sesión