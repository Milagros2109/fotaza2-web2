extends ../layout

block content
  h1 Registro

  form(method='POST' action='/auth/registro')
    div
      label Nombre
      input(type='text' name='nombre')

    div
      label Email
      input(type='email' name='email')

    div
      label Contraseña
      input(type='password' name='password')

    button(type='submit') Registrarse