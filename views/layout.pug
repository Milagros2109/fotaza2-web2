doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= pagina || 'Fotaza'
    link(rel='stylesheet', href='/css/styles.css')

  body
    header.navbar
      div.logo
        a(href='/') Fotaza

      nav.menu
        a(href='/') Inicio
        a(href='/posts') Publicaciones
        a(href='/posts/crear') Crear publicación
        a(href='/posts/following') Seguidos
        a(href='/users') Usuarios
        a.logout(href='/auth/logout') Cerrar sesión

    main.container
      block content
