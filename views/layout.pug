doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= pagina || 'Fotaza'
    link(rel='stylesheet', href='/css/styles.css')

  body
    header.navbar
      div.logo
        a(href='/') Fotaza

      nav.menu
        a(href='/') Inicio

        if currentUser
          a(href='/posts/crear') Crear publicación
          a(href='/posts/following') Seguidos
          a(href='/users') Usuarios
          a(href='/auth/logout') Cerrar sesión
          a(href='/users/profile') Mi perfil
        else
          a(href='/auth/login') Iniciar sesión
          a(href='/auth/registro') Registrarse

    main.container
      block content