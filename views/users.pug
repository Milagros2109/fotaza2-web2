extends layout

block content

  h1 Usuarios

  each user in users

    div.user-card

      p #{user.firstName} #{user.lastName}

      if Number(user.id) === Number(currentUserId)

        span.badge Es tu usuario

      else if followingIds.includes(user.id)

        span.badge Siguiendo

        form(method='POST' action='/users/unfollow')
          input(
            type='hidden'
            name='followingId'
            value=user.id
          )

          button.secondary(type='submit') Dejar de seguir

      else

        form(method='POST' action='/users/follow')
          input(
            type='hidden'
            name='followingId'
            value=user.id
          )

          button(type='submit') Seguir